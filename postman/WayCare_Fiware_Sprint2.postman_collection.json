        {
          "name": "3. Provisioning WayCare Dock Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "fiware-service",
                "value": "smart",
                "type": "text"
              },
              {
                "key": "fiware-servicepath",
                "value": "/",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"devices\": [\n    {\n      \"device_id\":   \"dock01\",\n      \"entity_name\": \"urn:ngsi-ld:WaycareDock:dock01\",\n      \"entity_type\": \"WaycareDock\",\n      \"protocol\":    \"IoTA-JSON\",\n      \"transport\":   \"MQTT\",\n      \"timezone\":    \"America/Sao_Paulo\",\n      \"attributes\": [\n        { \"object_id\": \"peso\",       \"name\": \"peso\",       \"type\": \"Float\"   },\n        { \"object_id\": \"consumo\",    \"name\": \"consumo\",    \"type\": \"Float\"   },\n        { \"object_id\": \"pct\",        \"name\": \"pct\",        \"type\": \"Float\"   },\n        { \"object_id\": \"fatias\",     \"name\": \"fatias\",     \"type\": \"Integer\" },\n        { \"object_id\": \"estado_led\", \"name\": \"estado_led\", \"type\": \"Text\"    }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://{{url}}:4041/iot/devices",
              "protocol": "http",
              "host": [
                "{{url}}"
