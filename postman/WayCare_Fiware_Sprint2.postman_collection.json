        {
          "name": "2. Subscribe consumo (historico)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "fiware-service",
                "value": "smart",
                "type": "text"
              },
              {
                "key": "fiware-servicepath",
                "value": "/",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Notify STH-Comet of all WayCare Dock consumo changes\",\n  \"subject\": {\n    \"entities\": [\n      {\n        \"id\":   \"urn:ngsi-ld:WaycareDock:dock01\",\n        \"type\": \"WaycareDock\"\n      }\n    ],\n    \"condition\": { \"attrs\": [\"consumo\"] }\n  },\n  \"notification\": {\n    \"http\": {\n      \"url\": \"http://{{url}}:8666/notify\"\n    },\n    \"attrs\": [\"consumo\"]\n  }\n}"
            },
            "url": {
              "raw": "http://{{url}}:1026/v2/subscriptions",
              "protocol": "http",
              "host": [
                "{{url}}"
              ],
              "port": "1026",
              "path": [
                "v2",
                "subscriptions"
              ]
            }
          },
          "response": []
        },
