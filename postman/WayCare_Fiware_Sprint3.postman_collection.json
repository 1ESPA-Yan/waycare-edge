{"info": {"name": "WayCare FIWARE - Sprint 3", "_postman_id": "waycare-fiware-sprint3", "description": "Provisiona a WayCare Dock no FIWARE. Nesta sprint o ESP32 envia APENAS o atributo 'peso' (peso estavel). Todo o resto (consumo, %, fatias, LED) e calculado no backend Python. Comandos (tara/led) saem do Python via MQTT direto, por isso NAO sao registrados como comandos FIWARE aqui.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"}, "variable": [{"key": "ORION", "value": "http://SEU_IP_DA_VM:1026"}, {"key": "IOTA", "value": "http://SEU_IP_DA_VM:4041"}, {"key": "APIKEY", "value": "waycare2025"}, {"key": "DEVICE_ID", "value": "dock01"}, {"key": "ENTITY_TYPE", "value": "WaycareDock"}, {"key": "ENTITY_ID", "value": "WaycareDock:dock01"}, {"key": "FIWARE_SERVICE", "value": "waycare"}, {"key": "FIWARE_PATH", "value": "/"}], "item": [{"name": "1. Health Check", "item": [{"name": "1.1 Orion - Versao", "request": {"method": "GET", "header": [], "url": {"raw": "{{ORION}}/version", "host": ["{{ORION}}"], "path": ["version"]}}}, {"name": "1.2 IoT Agent - Versao", "request": {"method": "GET", "header": [], "url": {"raw": "{{IOTA}}/iot/about", "host": ["{{IOTA}}"], "path": ["iot", "about"]}}}]}, {"name": "2. Provisionar Dispositivo", "item": [{"name": "2.1 Criar Service Group", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "fiware-service", "value": "{{FIWARE_SERVICE}}"}, {"key": "fiware-servicepath", "value": "{{FIWARE_PATH}}"}], "body": {"mode": "raw", "raw": "{\n  \"services\": [\n    {\n      \"apikey\": \"{{APIKEY}}\",\n      \"cbroker\": \"http://orion:1026\",\n      \"entity_type\": \"{{ENTITY_TYPE}}\",\n      \"resource\": \"/iot/json\"\n    }\n  ]\n}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{IOTA}}/iot/services", "host": ["{{IOTA}}"], "path": ["iot", "services"]}}}, {"name": "2.2 Registrar Dispositivo ESP32 (so 'peso')", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "fiware-service", "value": "{{FIWARE_SERVICE}}"}, {"key": "fiware-servicepath", "value": "{{FIWARE_PATH}}"}], "body": {"mode": "raw", "raw": "{\n  \"devices\": [\n    {\n      \"device_id\": \"{{DEVICE_ID}}\",\n      \"entity_name\": \"{{ENTITY_ID}}\",\n      \"entity_type\": \"{{ENTITY_TYPE}}\",\n      \"protocol\": \"PDI-IoTA-JSON\",\n      \"transport\": \"MQTT\",\n      \"attributes\": [\n        { \"object_id\": \"peso\", \"name\": \"peso\", \"type\": \"Number\" }\n      ]\n    }\n  ]\n}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{IOTA}}/iot/devices", "host": ["{{IOTA}}"], "path": ["iot", "devices"]}}}]}, {"name": "3. Verificar", "item": [{"name": "3.1 Listar Dispositivos", "request": {"method": "GET", "header": [{"key": "fiware-service", "value": "{{FIWARE_SERVICE}}"}, {"key": "fiware-servicepath", "value": "{{FIWARE_PATH}}"}], "url": {"raw": "{{IOTA}}/iot/devices", "host": ["{{IOTA}}"], "path": ["iot", "devices"]}}}, {"name": "3.2 Ver Entidade no Orion (peso atual)", "request": {"method": "GET", "header": [{"key": "fiware-service", "value": "{{FIWARE_SERVICE}}"}, {"key": "fiware-servicepath", "value": "{{FIWARE_PATH}}"}], "url": {"raw": "{{ORION}}/v2/entities/{{ENTITY_ID}}", "host": ["{{ORION}}"], "path": ["v2", "entities", "{{ENTITY_ID}}"]}}}]}, {"name": "4. Limpeza (recomecar do zero)", "item": [{"name": "4.1 Deletar Dispositivo", "request": {"method": "DELETE", "header": [{"key": "fiware-service", "value": "{{FIWARE_SERVICE}}"}, {"key": "fiware-servicepath", "value": "{{FIWARE_PATH}}"}], "url": {"raw": "{{IOTA}}/iot/devices/{{DEVICE_ID}}", "host": ["{{IOTA}}"], "path": ["iot", "devices", "{{DEVICE_ID}}"]}}}, {"name": "4.2 Deletar Service Group", "request": {"method": "DELETE", "header": [{"key": "fiware-service", "value": "{{FIWARE_SERVICE}}"}, {"key": "fiware-servicepath", "value": "{{FIWARE_PATH}}"}], "url": {"raw": "{{IOTA}}/iot/services/?resource=/iot/json&apikey={{APIKEY}}", "host": ["{{IOTA}}"], "path": ["iot", "services", ""], "query": [{"key": "resource", "value": ""}, {"key": "apikey", "value": "{{APIKEY}}"}]}}}]}]}